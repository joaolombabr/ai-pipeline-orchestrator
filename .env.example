# ── APPLICATION ──────────────────────────────────
APP_NAME=AI Pipeline Orchestrator
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# ── POSTGRESQL ────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_db
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_pass123

DATABASE_URL=postgresql+asyncpg://pipeline_user:pipeline_pass123@db:5432/pipeline_db

# ── REDIS ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass123
REDIS_URL=redis://:redis_pass123@redis:6379/0

# ── CELERY ────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_pass123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_pass123@redis:6379/1
